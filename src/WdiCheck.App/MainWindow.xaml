<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WdiCheck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WdiCheck">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="18" Height="18" />
                <TextBlock Text="WdiCheck" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="driver status from WinDriverIndex" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Declared up front, not created on the reset: text laid out after a reset may not draw. -->
        <InfoBar
            x:Name="GpuResetBar"
            Grid.Row="1"
            Margin="16,0,16,8"
            Severity="Warning"
            IsOpen="False"
            Visibility="Collapsed"
            Closed="GpuResetBar_Closed"
            Title="The graphics driver was reset"
            Message="After a driver update, parts of this window may not redraw. Restart WdiCheck to draw it again; your settings are kept.">
            <InfoBar.ActionButton>
                <Button Content="Restart WdiCheck" Click="RestartButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Drivers" Tag="drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- With an add-in graphics card, children list the board and each card (code-behind). -->
                <NavigationViewItem x:Name="ThisPcItem" Content="This PC" Tag="board">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
