<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdiCheck.App.Views.CardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WdiCheck.App.ViewModels"
    xmlns:api="using:WdiCheck.Core.Api"
    xmlns:views="using:WdiCheck.App.Views">

    <!-- The column's width is pinned to the viewport (code-behind): left to itself it took its content's natural width
         (~840 px), was centred, and its full-width children spilled off the right edge. -->
    <ScrollViewer SizeChanged="Scroller_SizeChanged">
        <StackPanel x:Name="Column" MaxWidth="1100" Padding="32,20,32,40" Spacing="16">
            <StackPanel>
                <TextBlock Text="Graphics card" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Card.IdText, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Spacing="6">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <TextBlock Text="This card is no longer detected. Run the check again from the Overview." Style="{StaticResource MutedTextStyle}"
                       Visibility="{x:Bind vm:Display.Hide(HasCard)}" />

            <StackPanel Spacing="16" Visibility="{x:Bind HasCard}">
                <!-- Identity + override -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Card.Title, FallbackValue=''}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Card.Subtitle, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Card.MatchText, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                            <HyperlinkButton Content="Vendor support page"
                                             NavigateUri="{x:Bind Card.SupportUrl, FallbackValue={x:Null}}"
                                             Visibility="{x:Bind vm:Display.Show(Card.HasSupportUrl), FallbackValue=Collapsed}" />
                            <HyperlinkButton Content="WinDriverIndex page"
                                             ToolTipService.ToolTip="This model's report on the WinDriverIndex site"
                                             NavigateUri="{x:Bind Card.IndexPageUrl, FallbackValue={x:Null}}"
                                             Visibility="{x:Bind vm:Display.Show(Card.HasIndexPageUrl), FallbackValue=Collapsed}" />
                            <!-- The GPU maker's driver page: the same for every model of the card. -->
                            <HyperlinkButton Content="{x:Bind Card.SiliconLinkText, FallbackValue=''}"
                                             NavigateUri="{x:Bind Card.SiliconUrl, FallbackValue={x:Null}}"
                                             Visibility="{x:Bind vm:Display.Show(Card.HasSiliconUrl), FallbackValue=Collapsed}" />
                            <Button Content="Use automatic match" Click="Auto_Click"
                                    Visibility="{x:Bind vm:Display.Show(Card.IsOverride), FallbackValue=Collapsed}" />
                        </StackPanel>
                        <AutoSuggestBox Grid.Row="1" Grid.ColumnSpan="2" MaxWidth="560" HorizontalAlignment="Left"
                                        PlaceholderText="Not your card? Search the WinDriverIndex catalogue (e.g. “4070 Ti Gaming”)"
                                        QueryIcon="Find"
                                        TextChanged="CardSearch_TextChanged" SuggestionChosen="CardSearch_SuggestionChosen">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="api:Board">
                                    <StackPanel Padding="0,4">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}">
                                            <Run Text="{x:Bind vm:Display.Vendor(Vendor)}" /><Run Text=" · " /><Run Text="{x:Bind Chipset}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                    </Grid>
                </Border>

                <InfoBar Severity="Warning" IsClosable="False" Title="Couldn't load every listing for this card"
                         IsOpen="{x:Bind Card.HasError, FallbackValue=False}" Visibility="{x:Bind vm:Display.Show(Card.HasError), FallbackValue=Collapsed}"
                         Message="{x:Bind Card.Error, FallbackValue=''}" />

                <!-- Asked for only when it would change the page (a model lists a VBIOS); the list is at the bottom. A closed InfoBar
                     still takes the panel's spacing, so these are collapsed too. -->
                <InfoBar Severity="Informational" IsOpen="{x:Bind Card.ModelMatters, FallbackValue=False}" IsClosable="False"
                         Visibility="{x:Bind vm:Display.Show(Card.ModelMatters), FallbackValue=Collapsed}"
                         Title="Which one is yours?"
                         Message="The PCI IDs Windows reports are shared by several models, and some of them list a VBIOS. Pick yours below, or search above." />

                <!-- Driver + VBIOS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Driver installed" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind Card.InstalledText, FallbackValue=''}" Style="{StaticResource VersionTextStyle}" VerticalAlignment="Center" />
                                <views:StatusPill Text="{x:Bind Card.StatusText, FallbackValue=''}" Severity="{x:Bind Card.StatusSeverity, FallbackValue=Neutral}" />
                                <TextBlock Text="{x:Bind Card.NewestText, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Vendor's newest VBIOS" Style="{StaticResource MutedTextStyle}"
                                       Visibility="{x:Bind vm:Display.Show(Card.HasVbios), FallbackValue=Collapsed}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Card.VbiosText, FallbackValue=''}" Style="{StaticResource VersionTextStyle}"
                                       Visibility="{x:Bind vm:Display.Show(Card.HasVbios), FallbackValue=Collapsed}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Card.VbiosNote, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                       Visibility="{x:Bind vm:Display.Show(Card.HasVbiosNote), FallbackValue=Collapsed}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind vm:Display.Show(Card.HasVbios), FallbackValue=Collapsed}"
                                   Text="Card makers number VBIOS releases their own way, so WdiCheck can't compare one with the VBIOS on your card. Check the version your card reports in the maker's own tool, and update only from the maker's support page." />
                        <TextBlock Text="{x:Bind Card.ReferenceText, FallbackValue=''}" TextWrapping="Wrap"
                                   Visibility="{x:Bind vm:Display.Show(Card.HasReference), FallbackValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <!-- Maker's listing vs installed -->
                <StackPanel Spacing="8" Visibility="{x:Bind vm:Display.Show(Card.HasFamilies), FallbackValue=Collapsed}">
                    <TextBlock Text="The card maker's driver listing" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="Read each row left to right: the driver installed here, against what the card maker's support page offers; then the maker's version, against the newest release anywhere. Where the possible models list different versions, both ends are shown." />
                    <views:ListingTable ItemsSource="{x:Bind Card.Families, FallbackValue={x:Null}}" Vendor="{x:Bind Card.Vendor, FallbackValue=''}" />
                </StackPanel>

                <!-- Which model, last: expanding the list then pushes nothing else down. -->
                <StackPanel Spacing="8" Visibility="{x:Bind vm:Display.Show(Card.HasCandidates), FallbackValue=Collapsed}">
                    <TextBlock Text="Your model" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind Card.ModelNote, FallbackValue=''}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Visibility="{x:Bind vm:Display.Show(Card.HasModelNote), FallbackValue=Collapsed}" />
                    <Expander Header="{x:Bind Card.CandidatesHeader, FallbackValue=''}"
                              IsExpanded="{x:Bind Card.ModelMatters, FallbackValue=False}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsRepeater ItemsSource="{x:Bind Card.Candidates, FallbackValue={x:Null}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CardCandidate">
                                    <!-- Pick the model, or look at its pages first to tell which one you have. -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{x:Bind Board}" Click="Candidate_Click"
                                                ToolTipService.ToolTip="This is my card">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Board.Name}" />
                                                <TextBlock Text="{x:Bind Board.Chipset}" Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <HyperlinkButton Grid.Column="1" Content="Vendor page" NavigateUri="{x:Bind SupportUrl}"
                                                         Visibility="{x:Bind vm:Display.Show(HasSupportUrl)}" />
                                        <HyperlinkButton Grid.Column="2" Content="WinDriverIndex" NavigateUri="{x:Bind IndexPageUrl}"
                                                         Visibility="{x:Bind vm:Display.Show(HasIndexPageUrl)}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
