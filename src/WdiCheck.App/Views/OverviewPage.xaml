<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdiCheck.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WdiCheck.App.ViewModels"
    xmlns:views="using:WdiCheck.App.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="1100" Padding="32,20,32,40" Spacing="16" HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Driver status" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.View.IdentityText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <DropDownButton Content="Export" IsEnabled="{x:Bind ViewModel.HasView, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="CSV (Excel)…" Click="ExportCsv_Click" />
                                <MenuFlyoutItem Text="JSON…" Click="ExportJson_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Check again" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Spacing="6">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <InfoBar Severity="Error" Title="Something went wrong" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
            <InfoBar Severity="Warning" Title="Offline" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.View.IsStale, Mode=OneWay, FallbackValue=False}"
                     Message="{x:Bind ViewModel.View.StaleText, Mode=OneWay}" />

            <InfoBar Severity="Informational" Title="Data" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.View.HasSchemaWarning, Mode=OneWay, FallbackValue=False}"
                     Message="{x:Bind ViewModel.View.SchemaWarning, Mode=OneWay}" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasView, Mode=OneWay}">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.View.Headline, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Each installed driver is compared with the newest release of the same INF file that any vendor WinDriverIndex tracks has published; where the index has no INF data, with the newest release on its version line." />
                    </StackPanel>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.View.Tiles, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinItemHeight="92" MinRowSpacing="12" MinColumnSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SummaryTile">
                            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Top" Padding="16,12" Tag="{x:Bind Filter}" Click="Tile_Click"
                                    ToolTipService.ToolTip="Show these drivers">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Count}" Style="{StaticResource TitleTextBlockStyle}" />
                                    <views:StatusPill Text="{x:Bind Label}" Severity="{x:Bind Severity}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="This machine" Style="{StaticResource ColumnHeaderStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.View.BoardTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.View.BoardSubtitle, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.View.VendorVerdict, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{x:Bind ViewModel.View.HasBoardReport, Mode=OneWay, FallbackValue=Collapsed}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"
                                        Visibility="{x:Bind ViewModel.View.HasBoardReport, Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBlock Text="BIOS" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.View.BiosSummaryText, Mode=OneWay}" Style="{StaticResource VersionTextStyle}" VerticalAlignment="Center" />
                                <views:StatusPill Text="{x:Bind ViewModel.View.BiosPill, Mode=OneWay}" Severity="{x:Bind ViewModel.View.BiosSeverity, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Content="Board report" Click="Board_Click" />
                    </Grid>
                </Border>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.View.HasAttention, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock Text="Needs attention" Style="{StaticResource SectionHeaderStyle}" />
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10"
                                Background="Transparent" BorderThickness="0" CornerRadius="0" Click="Board_Click"
                                Visibility="{x:Bind ViewModel.View.BiosUpdateAvailable, Mode=OneWay, FallbackValue=Collapsed}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BIOS" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.View.BiosUpdateText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <views:StatusPill Grid.Column="1" Text="{x:Bind ViewModel.View.BiosPill, Mode=OneWay}"
                                                  Severity="{x:Bind ViewModel.View.BiosSeverity, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.View.Attention, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceRowViewModel">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10"
                                            Background="Transparent" BorderThickness="0" CornerRadius="0"
                                            Tag="{x:Bind Name}" Click="Attention_Click">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}">
                                                    <Run Text="{x:Bind Family}" /><Run Text=" · " /><Run Text="{x:Bind Installed}" /><Run Text=" → " /><Run Text="{x:Bind Newest}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <views:StatusPill Grid.Column="1" Text="{x:Bind StatusText}" Severity="{x:Bind Severity}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="{x:Bind ViewModel.View.FreshnessText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="“Newest” means the newest version any vendor or upstream source has published — not a judgement that it is good. A vendor may legitimately withhold a driver that regressed; read release notes before updating. Lag is measured by release date." />
                    <TextBlock Style="{StaticResource MutedTextStyle}">
                        <Run Text="Data: " /><Hyperlink NavigateUri="https://windriverindex.tucny.com/">WinDriverIndex</Hyperlink><Run Text=", licensed CC-BY-4.0." />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
