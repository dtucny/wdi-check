<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdiCheck.App.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WdiCheck.App.ViewModels"
    xmlns:api="using:WdiCheck.Core.Api"
    xmlns:match="using:WdiCheck.Core.Matching"
    xmlns:views="using:WdiCheck.App.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="1100" Padding="32,20,32,40" Spacing="16">
            <StackPanel>
                <TextBlock Text="This PC's board" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.View.IdentityText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Spacing="6">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <!-- Identity + override -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.View.BoardTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.View.BoardSubtitle, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.View.BoardMatchText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <HyperlinkButton Content="Vendor support page"
                                         NavigateUri="{x:Bind ViewModel.View.SupportUrl, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.View.HasSupportUrl, Mode=OneWay, FallbackValue=Collapsed}" />
                        <Button Content="Use automatic match" Click="Auto_Click"
                                Visibility="{x:Bind ViewModel.View.IsBoardOverride, Mode=OneWay, FallbackValue=Collapsed}" />
                    </StackPanel>
                    <AutoSuggestBox x:Name="BoardSearch" Grid.Row="1" Grid.ColumnSpan="2" MaxWidth="560" HorizontalAlignment="Left"
                                    PlaceholderText="Not your machine? Search the WinDriverIndex catalogue (e.g. “B650 Tomahawk”)"
                                    QueryIcon="Find" DisplayMemberPath="Name"
                                    TextChanged="BoardSearch_TextChanged" SuggestionChosen="BoardSearch_SuggestionChosen">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="api:Board">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}">
                                        <Run Text="{x:Bind vm:Display.Vendor(Vendor)}" /><Run Text=" · " /><Run Text="{x:Bind ProductType}" /><Run Text=" · " /><Run Text="{x:Bind Chipset}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </Border>

            <!-- Ambiguous automatic match -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.View.ShowCandidates, Mode=OneWay, FallbackValue=Collapsed}">
                <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="Which one is yours?"
                         Message="SMBIOS didn't identify a single catalogue entry. Pick your machine below, or search above." />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.View.Candidates, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="match:BoardCandidate">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{x:Bind Board}" Click="Candidate_Click">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Board.Name}" />
                                    <TextBlock Text="{x:Bind Reason}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <InfoBar Severity="Warning" IsClosable="False" Title="Couldn't load this machine's report"
                     IsOpen="{x:Bind ViewModel.View.HasBoardError, Mode=OneWay, FallbackValue=False}"
                     Message="{x:Bind ViewModel.View.BoardError, Mode=OneWay}" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.View.HasBoardReport, Mode=OneWay, FallbackValue=Collapsed}">
                <!-- Vendor verdict + BIOS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.View.VendorVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="BIOS installed" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.View.InstalledBiosText, Mode=OneWay}" Style="{StaticResource VersionTextStyle}" VerticalAlignment="Center" />
                                <views:StatusPill Text="{x:Bind ViewModel.View.BiosPill, Mode=OneWay}" Severity="{x:Bind ViewModel.View.BiosSeverity, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Vendor's newest BIOS" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.View.VendorBiosText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.View.AgesaText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="BIOS status compares the installed BIOS release date with the newest BIOS the vendor lists. Update BIOS only from the vendor's support page and follow its instructions." />
                    </StackPanel>
                </Border>

                <!-- Vendor listing vs installed -->
                <StackPanel Spacing="8">
                    <TextBlock Text="The vendor's driver listing for this model" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="What the vendor's support page offers per driver family, the newest release anywhere, and what is installed on this PC. The lag is how far the vendor's listing trails the newest release." />
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                            <StackPanel>
                                <Grid Padding="20,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FAMILY" Style="{StaticResource ColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="1" Text="VENDOR LISTS" Style="{StaticResource ColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="2" Text="NEWEST ANYWHERE" Style="{StaticResource ColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="3" Text="INSTALLED HERE" Style="{StaticResource ColumnHeaderStyle}" />
                                    <TextBlock Grid.Column="4" Text="VENDOR LAG" Style="{StaticResource ColumnHeaderStyle}" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.View.BoardFamilies, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BoardFamilyItem">
                                            <Grid Padding="20,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Family}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Component}" Style="{StaticResource MutedTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Listed}" Style="{StaticResource VersionTextStyle}" />
                                                    <TextBlock Text="{x:Bind ListedDate}" Style="{StaticResource MutedTextStyle}" />
                                                    <TextBlock Text="{x:Bind SameLineNote}" Style="{StaticResource MutedTextStyle}"
                                                               Visibility="{x:Bind vm:Display.ShowText(SameLineNote)}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{x:Bind Newest}" Style="{StaticResource VersionTextStyle}" />
                                                    <TextBlock Text="{x:Bind NewestDate}" Style="{StaticResource MutedTextStyle}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Installed}" Style="{StaticResource VersionTextStyle}" TextWrapping="Wrap" />
                                                <views:StatusPill Grid.Column="4" VerticalAlignment="Top" Text="{x:Bind LagText}" Severity="{x:Bind LagSeverity}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
